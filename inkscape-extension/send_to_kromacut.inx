<?xml version="1.0" encoding="UTF-8"?>
<inkscape-extension xmlns="http://www.inkscape.org/namespace/inkscape/extension">
  <name>Send to Kromacut</name>
  <id>org.kamillion.send_to_kromacut</id>

  <param name="mode" type="optiongroup" appearance="combo" gui-text="Target type:">
    <option value="lithophane">Lithophane (single filament)</option>
    <option value="colorlayer">Color Layer (multi filament)</option>
  </param>

  <param name="kromacut_path" type="path" mode="file" gui-text="Kromacut executable:"
         gui-description="Path to the Kromacut app on this computer. Only needs to be set once - it's remembered after that."/>

  <effect>
    <object-type>all</object-type>
    <effects-menu/>
  </effect>

  <script>
    <command location="inx" interpreter="python">send_to_kromacut.py</command>
  </script>
</inkscape-extension>
